generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  passwordHash       String
  role               Role                    @default(STUDENT)
  createdAt          DateTime                @default(now())
  phoneNumber        String?
  dashboardLayout    Json?
  classGroupId       String?
  branch             BranchLocation          @default(KARTASURA)
  announcements      Announcement[]
  attendances        Attendance[]
  cashflows          Cashflow[]
  StudentEvaluations DescriptiveEvaluation[] @relation("StudentEvaluations")
  TutorEvaluations   DescriptiveEvaluation[] @relation("TutorEvaluations")
  enrollments        Enrollment[]
  leadsHandled       Lead[]                  @relation("UserLeads")
  Payment            Payment[]
  sessionsTaught     Session[]               @relation("SessionTutor")
  targets            StaffTarget[]
  classGroup         ClassGroup?             @relation(fields: [classGroupId], references: [id])
  assignedSessions   Session[]               @relation("SessionAssignments")
}

model DescriptiveEvaluation {
  id            String   @id @default(cuid())
  fluency       String
  pronunciation String
  vocabulary    String
  notes         String?
  studentId     String
  tutorId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       User     @relation("StudentEvaluations", fields: [studentId], references: [id], onDelete: Cascade)
  tutor         User     @relation("TutorEvaluations", fields: [tutorId], references: [id], onDelete: Cascade)
}

model Session {
  id               String         @id @default(cuid())
  date             DateTime
  timeSlot         String
  isCompleted      Boolean        @default(false)
  tutorId          String
  programType      String
  title            String
  classGroupId     String?
  branch           BranchLocation @default(KARTASURA)
  topicOffset      Int            @default(0)
  attendances      Attendance[]
  classGroup       ClassGroup?    @relation(fields: [classGroupId], references: [id])
  tutor            User           @relation("SessionTutor", fields: [tutorId], references: [id])
  assignedStudents User[]         @relation("SessionAssignments")
}

model ClassGroup {
  id        String         @id @default(cuid())
  name      String
  program   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branch    BranchLocation @default(KARTASURA)
  sessions  Session[]
  students  User[]
}

model Attendance {
  id              String           @id @default(cuid())
  sessionId       String
  studentId       String
  status          AttendanceStatus @default(PRESENT)
  pronunciation   Int?
  fluency         Int?
  vocabulary      Int?
  tutorNotes      String?
  rescheduleNotes String?
  isGuest         Boolean          @default(false)
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student         User             @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String
  targetRole Role?
  authorId   String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
}

model Lead {
  id         String         @id @default(cuid())
  name       String
  whatsapp   String
  status     LeadStatus     @default(NEW)
  notes      String?
  assigneeId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  branch     BranchLocation @default(KARTASURA)
  invoices   Invoice[]
  assignee   User?          @relation("UserLeads", fields: [assigneeId], references: [id])
}

model StaffTarget {
  id           String        @id @default(cuid())
  userId       String
  period       String
  title        String
  targetValue  Float
  currentValue Float         @default(0)
  unitName     String
  trackingType TrackingType  @default(MANUAL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  logs         ProgressLog[]
  user         User          @relation(fields: [userId], references: [id])
}

model ProgressLog {
  id         String      @id @default(cuid())
  targetId   String
  valueAdded Float
  notes      String?
  proofLink  String?
  createdAt  DateTime    @default(now())
  target     StaffTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  leadId        String
  programName   String
  amountDue     Float
  status        InvoiceStatus  @default(PENDING)
  paymentMethod String?
  paymentProof  String?
  studentData   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paidAmount    Int            @default(0)
  totalAmount   Int            @default(0)
  branch        BranchLocation @default(KARTASURA)
  cashflows     Cashflow[]
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Cashflow {
  id           String              @id @default(cuid())
  type         TransactionType
  category     TransactionCategory
  amount       Int
  description  String
  date         DateTime            @default(now())
  invoiceId    String?
  recordedById String?
  branch       BranchLocation      @default(KARTASURA)
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id])
  recordedBy   User?               @relation(fields: [recordedById], references: [id])
}

model GlobalHoliday {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  programType      String
  durationOption   String?
  programBatch     String?
  batchSchedule    String?
  programStartDate DateTime?
  startDate        DateTime
  endDate          DateTime?
  leaveQuota       Int       @default(0)
  leaveUsed        Int       @default(0)
  totalLeaves      Int       @default(0)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Payment          Payment[]
}

model DailyHomework {
  id        String         @id
  date      DateTime
  branch    BranchLocation @default(KARTASURA)
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime

  @@unique([date, branch])
}

model Payment {
  id            String      @id
  userId        String
  enrollmentId  String?
  amount        Float
  paymentMethod String
  status        String      @default("PAID")
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Enrollment    Enrollment? @relation(fields: [enrollmentId], references: [id])
  User          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  MANAGER
  CS
  MARKETING
  CREATOR
  HEAD_TUTOR
  TUTOR
  STUDENT
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  WAITING_CONFIRMATION
  DP_PAID
}

enum TrackingType {
  MANUAL
  AUTO_LEAD
  AUTO_REVENUE
  AUTO_ATTENDANCE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  SICK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  REGISTRATION_FEE
  OPERATIONAL
  SALARY
  MARKETING
  OTHER
  DP
  PELUNASAN
}

enum BranchLocation {
  KARTASURA
  CABANG_2
  CABANG_3
}
