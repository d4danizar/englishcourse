generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---
enum Role {
  SUPER_ADMIN
  MANAGER
  CS
  MARKETING
  CREATOR
  TUTOR
  HEAD_TUTOR
  STUDENT
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InvoiceStatus {
  PENDING
  WAITING_CONFIRMATION
  DP_PAID
  PAID
  CANCELLED
}

enum TrackingType {
  MANUAL          // Di-update oleh user via UI (Contoh: Creator upload video)
  AUTO_LEAD       // Di-update otomatis oleh sistem saat ada lead baru
  AUTO_REVENUE    // Di-update otomatis saat invoice lunas
  AUTO_ATTENDANCE // Di-update otomatis saat kelas selesai
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED // Izin
  SICK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  REGISTRATION_FEE
  OPERATIONAL
  SALARY
  MARKETING
  OTHER
  DP
  PELUNASAN
}

enum BranchLocation {
  KARTASURA
  CABANG_2
  CABANG_3
}

// ============================================================
// --- MODELS (Open Pool / Gym Membership Architecture) ---
// ============================================================

// TODO: Run 'npx prisma db push' after saving this schema

// User: Admin, Tutor, atau Student
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  phoneNumber   String?
  role          Role     @default(STUDENT)
  branch        BranchLocation @default(KARTASURA)
  createdAt     DateTime @default(now())

  // Paket aktif siswa (hanya relevan untuk STUDENT)
  // Dipindahkan ke model Enrollment untuk mendukung Multiple Purchases (Repeat Order)
  
  // Student Pool / Kelas Utama (Rombel)
  classGroupId   String?
  classGroup     ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  // Sub-relasi Siklus Belajar
  enrollments    Enrollment[]
  payments       Payment[]

  // Relasi
  sessionsTaught Session[]      @relation("SessionTutor")  // Sesi yang diajar (untuk TUTOR)
  attendances    Attendance[]                                // Kehadiran siswa (untuk STUDENT)
  announcements  Announcement[]                              // Pengumuman (untuk ADMIN)
  StudentEvaluations DescriptiveEvaluation[] @relation("StudentEvaluations")
  TutorEvaluations   DescriptiveEvaluation[] @relation("TutorEvaluations")
  assignedSessions   Session[] @relation("SessionAssignments")

  // CRM & Dashboard Preferences
  dashboardLayout    Json?
  leadsHandled       Lead[]         @relation("UserLeads")

  // KPI Engine
  targets            StaffTarget[]

  // Financial
  cashflows          Cashflow[]
}

model DescriptiveEvaluation {
  id            String   @id @default(cuid())
  fluency       String   @db.Text
  pronunciation String   @db.Text
  vocabulary    String   @db.Text
  notes         String?  @db.Text
  studentId     String
  tutorId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       User     @relation("StudentEvaluations", fields: [studentId], references: [id], onDelete: Cascade)
  tutor         User     @relation("TutorEvaluations", fields: [tutorId], references: [id], onDelete: Cascade)
}

// Session: Entitas utama jadwal (seperti "kelas gym" yang dijadwalkan)
// Setiap sesi adalah 1 pertemuan independen, tidak terikat ke "Kelas" tertentu.
model Session {
  id          String   @id @default(cuid())
  title       String   // cth: "Conversation - Room A", "Grammar Intensif - Room B"
  date        DateTime // Tanggal sesi berlangsung
  timeSlot    String   // cth: "08:00 - 09:30"
  programType String   // cth: "Conversation", "Grammar", "EFK", "Private", "TOEFL"
  branch      BranchLocation @default(KARTASURA)
  isCompleted Boolean  @default(false) // true = tutor sudah submit absen (trigger payroll)
  topicOffset Int      @default(0) // Untuk loncat topik

  // Relasi Rombel
  classGroupId String?
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  // Tutor yang mengajar sesi ini
  tutorId String
  tutor   User   @relation("SessionTutor", fields: [tutorId], references: [id])

  // Relasi
  attendances Attendance[] // Siswa yang hadir di sesi ini
  assignedStudents User[]  @relation("SessionAssignments")
}

// Model Rombongan Belajar (Rombel)
model ClassGroup {
  id          String   @id @default(cuid())
  name        String   // misal: "Reguler - Sesi 1"
  program     String   // misal: "Regular", "Fullday"
  branch      BranchLocation @default(KARTASURA)
  
  // Relasi
  students    User[]   // Siswa tetap di rombel ini
  sessions    Session[] // Sesi kelas mingguan rombel ini

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Attendance: Tiket masuk siswa + Rapor evaluasi per sesi
// Ini adalah "join table" antara Student dan Session,
// sekaligus menyimpan hasil evaluasi granular dari tutor.
model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  isGuest   Boolean          @default(false) // Tandai jika ini siswa sit-in

  // Evaluasi Speaking (Opsional, diisi tutor saat submit attendance)
  pronunciation Int?    // Skala 1-5
  fluency       Int?    // Skala 1-5
  vocabulary    Int?    // Skala 1-5
  tutorNotes    String? @db.Text

  // Catatan reschedule (khusus Private Class)
  rescheduleNotes String? @db.Text

  // Relasi
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id])

  // 1 siswa tidak bisa punya 2 record attendance di sesi yang sama
  @@unique([sessionId, studentId])
}

// Sistem Pengumuman (Admin broadcast ke Tutor/Student)
model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  targetRole Role?    // null = untuk semua role
  authorId   String
  createdAt  DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
}

// ============================================================
// --- CRM & LEADS ---
// ============================================================

model Lead {
  id          String       @id @default(cuid())
  name        String
  whatsapp    String
  status      LeadStatus   @default(NEW)
  notes       String?      @db.Text
  branch      BranchLocation @default(KARTASURA)
  
  // Relasi ke CS/Admin yang menangani
  assigneeId  String?
  assignee    User?        @relation("UserLeads", fields: [assigneeId], references: [id])

  invoices    Invoice[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ── KPI / WIG Universal Target Engine ────────────────────────────────────────
model StaffTarget {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])

  period       String       // Format: "MM-YYYY" (Contoh: "03-2026")
  title        String       // Nama KPI (Contoh: "Upload Tiktok", "Target Omzet")
  targetValue  Float        // Float untuk mendukung nominal uang besar
  currentValue Float        @default(0)
  unitName     String       // Satuan (Contoh: "Video", "Rupiah", "Leads")

  trackingType TrackingType @default(MANUAL)
  // proofLink dipindah ke ProgressLog untuk audit trail per-hari

  logs         ProgressLog[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ── Audit Trail: daily progress logs ─────────────────────────────────────────
model ProgressLog {
  id         String      @id @default(cuid())
  targetId   String
  target     StaffTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  valueAdded Float       // Angka penambahan hari ini
  notes      String?     @db.Text  // Catatan pekerjaan hari ini
  proofLink  String?     @db.Text  // Link bukti harian (GDrive/Tiktok)

  createdAt  DateTime    @default(now())
}

// ── Invoice / Tagihan Siswa ───────────────────────────────────────────────────
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // Format: INV-20260324-001

  // Relasi ke Lead (prospek yang ditagih)
  leadId        String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Detail program & pembayaran
  programName   String
  amountDue     Float
  totalAmount   Int           @default(0)
  paidAmount    Int           @default(0)
  status        InvoiceStatus @default(PENDING)
  branch        BranchLocation @default(KARTASURA)

  paymentMethod String?      // "MANUAL_TRANSFER" | "CASH_ON_SITE" | "GATEWAY"
  paymentProof  String?      @db.Text // URL foto struk transfer

  // Data form pendaftaran (alamat, asal sekolah, dll)
  studentData   Json?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cashflows     Cashflow[]
}

// ── Financial / Cashflow ──────────────────────────────────────────────────────
model Cashflow {
  id           String              @id @default(cuid())
  type         TransactionType
  category     TransactionCategory
  amount       Int
  description  String
  date         DateTime            @default(now())
  branch       BranchLocation      @default(KARTASURA)
  
  invoiceId    String?
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  recordedById String?
  recordedBy   User?               @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

// Homework: Papan pengumuman tugas harian per cabang
model DailyHomework {
  id        String         @id @default(cuid())
  date      DateTime       // Tanggal PR ditugaskan (tanpa jam)
  branch    BranchLocation @default(KARTASURA)
  content   String         @db.Text // Isi teks PR/Instruksi
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([date, branch]) // 1 cabang hanya punya 1 homework per hari
}

// -------------------------------------------------------------
// ENROLLMENT & PAYMENT MODELS (NEW THE GRAND REFACTOR)
// -------------------------------------------------------------

model Enrollment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programType     String
  durationOption  String?  // Pilihan durasi: "1_WEEK", "2_WEEKS", "3_WEEKS", "1_MONTH", "2_MONTHS"
  programBatch    String?  // Sesi/Jam default untuk Regular
  batchSchedule   String?  // Jadwal batch EFK/EFT
  
  // Waktu
  programStartDate DateTime? 
  startDate        DateTime
  endDate          DateTime?
  
  // Izin & Absen khusus Enrollment ini
  leaveQuota      Int      @default(0)
  leaveUsed       Int      @default(0)
  totalLeaves     Int      @default(0)
  
  status          String   @default("ACTIVE") // ACTIVE, GRADUATED, DROPOUT, ON_LEAVE
  
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  enrollmentId    String?
  enrollment      Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  
  amount          Float
  paymentMethod   String      // CASH, TRANSFER, QURIS
  status          String      @default("PAID") // PAID, PENDING, FAILED, REFUNDED
  description     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
