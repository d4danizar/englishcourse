generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  passwordHash       String
  role               Role                    @default(STUDENT)
  createdAt          DateTime                @default(now())
  phoneNumber        String?
  dashboardLayout    Json?
  classGroupId       String?
  branch             BranchLocation          @default(KARTASURA)
  birthDate          DateTime?
  birthPlace         String?
  discoverySource    String?
  gender             String?
  occupation         String?
  address            String?
  secondaryBranch    BranchLocation?
  referralCode       String?                 @unique
  announcements      Announcement[]
  attendances        Attendance[]
  cashflows          Cashflow[]
  StudentEvaluations DescriptiveEvaluation[] @relation("StudentEvaluations")
  TutorEvaluations   DescriptiveEvaluation[] @relation("TutorEvaluations")
  enrollments        Enrollment[]
  leadsHandled       Lead[]                  @relation("UserLeads")
  Payment            Payment[]
  sessionsTaught     Session[]               @relation("SessionTutor")
  targets            StaffTarget[]
  classGroup         ClassGroup?             @relation(fields: [classGroupId], references: [id])
  assignedSessions   Session[]               @relation("SessionAssignments")
}

model DescriptiveEvaluation {
  id                 String   @id @default(cuid())
  studentId          String
  tutorId            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Scores (Float to allow 3.5, 4.5, etc.)
  listeningScore     Float?
  speakingScore      Float?
  readingScore       Float?
  pronunciationScore Float?
  vocabularyScore    Float?
  
  // Specific Notes
  listeningNote      String? @db.Text
  speakingNote       String? @db.Text
  readingNote        String? @db.Text
  pronunciationNote  String? @db.Text
  vocabularyNote     String? @db.Text
  
  // Summary Sections
  strengths          String? @db.Text
  improvements       String? @db.Text
  nextTarget         String? @db.Text
  tutorNote          String? @db.Text

  student            User     @relation("StudentEvaluations", fields: [studentId], references: [id], onDelete: Cascade)
  tutor              User     @relation("TutorEvaluations", fields: [tutorId], references: [id], onDelete: Cascade)
}

model Session {
  id               String         @id @default(cuid())
  date             DateTime?
  timeSlot         String?
  isCompleted      Boolean        @default(false)
  tutorId          String
  programType      String
  title            String
  classGroupId     String?
  branch           BranchLocation @default(KARTASURA)
  topicOffset      Int            @default(0)
  attendances      Attendance[]
  classGroup       ClassGroup?    @relation(fields: [classGroupId], references: [id])
  tutor            User           @relation("SessionTutor", fields: [tutorId], references: [id])
  assignedStudents User[]         @relation("SessionAssignments")
}

model ClassGroup {
  id            String         @id @default(cuid())
  name          String
  program       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        BranchLocation @default(KARTASURA)
  classType     String         @default("REGULAR")
  totalSessions Int?
  sessions      Session[]
  students      User[]
}

model Attendance {
  id              String           @id @default(cuid())
  sessionId       String
  studentId       String
  status          AttendanceStatus @default(PRESENT)
  pronunciation   Int?
  fluency         Int?
  vocabulary      Int?
  tutorNotes      String?
  rescheduleNotes String?
  isGuest         Boolean          @default(false)
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student         User             @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String
  targetRole Role?
  authorId   String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
}

model Lead {
  id               String         @id @default(cuid())
  name             String
  whatsapp         String
  phone            String?        @unique
  source           LeadSource     @default(ORGANIC)
  status           LeadStatus     @default(NEW)
  currentStage     Int            @default(0) // Tracks which follow-up stage they are on (0 to 8)
  nextReminderDate DateTime?      // When the CS/CRM needs to contact them again
  notes            String?
  assigneeId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  branch           BranchLocation @default(KARTASURA)
  tshirtSize       String?
  discoverySource  String?
  invoices         Invoice[]
  assignee         User?          @relation("UserLeads", fields: [assigneeId], references: [id])
  followUps        FollowUp[]
}

model FollowUp {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  stage       Int      // 1 through 8
  note        String   @db.Text
  contactedAt DateTime @default(now()) // When this specific follow-up happened
  handledBy   String   // Name or ID of the CS/CRM staff who did this

  @@unique([leadId, stage]) // Prevent duplicate stages for the same lead
}

model MarketingSource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model StaffTarget {
  id           String        @id @default(cuid())
  userId       String
  period       String
  title        String
  targetValue  Float
  currentValue Float         @default(0)
  unitName     String
  trackingType TrackingType  @default(MANUAL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  logs         ProgressLog[]
  user         User          @relation(fields: [userId], references: [id])
}

model ProgressLog {
  id         String      @id @default(cuid())
  targetId   String
  valueAdded Float
  notes      String?
  proofLink  String?
  createdAt  DateTime    @default(now())
  target     StaffTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  leadId        String
  programName   String
  amountDue     Float
  status        InvoiceStatus  @default(PENDING)
  paymentMethod String?
  paymentProof  String?
  studentData   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paidAmount    Int            @default(0)
  totalAmount   Int            @default(0)
  branch        BranchLocation @default(KARTASURA)
  cashflows     Cashflow[]
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Cashflow {
  id            String              @id @default(cuid())
  type          TransactionType
  category      TransactionCategory
  amount        Int
  description   String
  date          DateTime            @default(now())
  invoiceId     String?
  recordedById  String?
  branch        BranchLocation      @default(KARTASURA)
  paymentMethod String?
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id])
  recordedBy    User?               @relation(fields: [recordedById], references: [id])
}

model GlobalHoliday {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
}

model Enrollment {
  id                    String    @id @default(cuid())
  userId                String
  programType           String
  durationOption        String?
  programBatch          String?
  batchSchedule         String?
  programStartDate      DateTime?
  startDate             DateTime
  endDate               DateTime?
  leaveQuota            Int       @default(0)
  leaveUsed             Int       @default(0)
  totalLeaves           Int       @default(0)
  status                String    @default("ACTIVE")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  referralCodeUsed      String?
  certificateScore      Float?
  finalVideoLink        String?
  isCertificateApproved Boolean   @default(false)
  tshirtSize            String?
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  Payment               Payment[]
  certificate           Certificate?
}

model Certificate {
  id                 String     @id @default(cuid())
  certificateNumber  String     @unique
  fluencyScore       Float?
  pronunciationScore Float?
  vocabularyScore    Float?
  finalScore         Float
  issuedAt           DateTime   @default(now())
  
  // Relations
  enrollmentId       String     @unique
  enrollment         Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model DailyHomework {
  id        String         @id
  date      DateTime
  branch    BranchLocation @default(KARTASURA)
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime

  @@unique([date, branch])
}

model Payment {
  id            String      @id
  userId        String
  enrollmentId  String?
  amount        Float
  paymentMethod String
  status        String      @default("PAID")
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Enrollment    Enrollment? @relation(fields: [enrollmentId], references: [id])
  User          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OffDay {
  id          String   @id @default(cuid())
  description String
  endDate     DateTime
  startDate   DateTime
}

model BonusTier {
  id         String   @id @default(cuid())
  minOmzet   Float
  maxOmzet   Float?
  percentage Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  MANAGER
  CS
  MARKETING
  CREATOR
  TUTOR
  STUDENT
  HEAD_TUTOR
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  NEGOTIATION
  CS_FOLLOW_UP    // Currently in stage 1-3
  CRM_FOLLOW_UP   // Escalated to stage 4-8
  CLOSED_WON      // Registered/Paid (DO NOT FOLLOW UP)
  CLOSED_LOST     // Dead lead / Refused permanently
}

enum LeadSource {
  META_ADS
  WEBSITE
  ORGANIC
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  WAITING_CONFIRMATION
  DP_PAID
}

enum TrackingType {
  MANUAL
  AUTO_LEAD
  AUTO_REVENUE
  AUTO_ATTENDANCE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  SICK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  REGISTRATION_FEE
  OPERATIONAL
  SALARY
  MARKETING
  OTHER
  DP
  PELUNASAN
}

enum BranchLocation {
  KARTASURA
  CABANG_2
  CABANG_3
}
